generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model Issue {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  eventDate   DateTime
  createdAt   DateTime @default(now())
}

model Recommendation {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  description String
  createdAt   DateTime @default(now())
}
